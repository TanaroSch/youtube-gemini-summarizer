{
  "manifest_version": 3,
  "name": "YouTube → homeserver",
  "version": "1.0.0",
  "description": "Rechtsklick auf ein YouTube-Video: im Hintergrund auf homeserver transkribieren und zusammenfassen (Notiz + ntfy).",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "https://tools.server.tanaro.one/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube → homeserver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
